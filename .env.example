# Copie para .env.local e preencha com os dados do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor (nunca use NEXT_PUBLIC_): chave da API da Anthropic para o tutor e os
# questionários (console.anthropic.com → API Keys; defina um limite de gasto).
# Sem ela, o localhost usa respostas simuladas (modo demonstração).
ANTHROPIC_API_KEY=sk-ant-...
